// fin-ssg — a static site generator CLI written in Fin.
//
// Reads Markdown files from a content directory, renders them to HTML
// fragments with a vendored Markdown subset (src/vendor/markdown.fin),
// wraps each page in a layout template with a vendored {{key}} engine
// (src/vendor/template.fin), and writes the static site to an output
// directory, plus an index.html listing every page.
//
// Usage:
//   fin-ssg [--content DIR] [--layout DIR] [--out DIR] [--title TITLE]
//
// Markdown files may start with front matter:
//
//   ---
//   title: My First Post
//   date: 2026-10-20
//   ---
//
// The layout file is <layout-dir>/page.html and may use {{site_title}},
// {{title}}, {{date}} and {{content}}. If it is missing, a minimal
// built-in layout is used.
//
// Exit codes: 0 = all pages built, 1 = usage/environment error,
// 2 = some pages failed (warnings name each one; the rest were built).
//
// Design notes (Fin v0.4.0 realities):
//   - argv arrives via /proc/self/cmdline (Linux-only), following the exact
//     recipe in cli::std — the same @define spellings, buffer size, and
//     NUL-segment walk. argparse::std then parses the grammar.
//   - fs::std has no directory listing, so content/*.md is enumerated with
//     popen("ls -1 -- '<dir>'") + fgets, the same opaque-handle @define
//     pattern as fin-kv's kv_recv. The directory is single-quote-rejected
//     (never interpolated raw) so no shell injection is possible.
//   - `blame` never fires on user-controlled input: unreadable files,
//     bad front matter and write failures become warnings + exit code 2.
//   - Multi-file layout: src/vendor/*.fin are the canonical vendored
//     sources, imported by name (import { md_to_html } from markdown::fin)
//     exactly like finson/zhttp consumers do. They compile with
//     `finc -I src/vendor src/main.fin`. If codegen ever refuses an
//     imported Fin function body, the fallback is to inline the two vendor
//     files into main.fin (they are dependency-free by construction).
//   - UNVERIFIED: no working `finc` exists in this environment yet, so this
//     file has not been through `finc` check / `-o` / run. It is written
//     strictly against docs/agent-guide.md and the stdlib sources.

import { ArgParser, new_arg_parser, free_arg_parser } from argparse::std;
import { is_dir, is_file, read_to_string, write_string, create_dir, free_file_content } from fs::std;
import { len, substr, concat, equals, starts_with, ends_with, trim, index_of_char, from_chars, free_str, contains } from strings::std;
import { md_to_html, md_escape_html } from markdown::fin;
import { tpl_render } from template::fin;

// --- argv via Linux procfs (same recipe as cli::std) -----------------------
#[llvm_name="open"]
@define ssg_open(path: string, flags: int) <int>;

#[llvm_name="read"]
@define ssg_read(fd: int, buf: &char, count: ulong) <long>;

#[llvm_name="close"]
@define ssg_close(fd: int) <int>;

// --- directory listing via popen (fs::std has no readdir listing) ----------
#[llvm_name="popen"]
@define ssg_popen(command: string, mode: string) <&void>;

#[llvm_name="fgets"]
@define ssg_fgets(buf: &char, size: int, stream: &void) <&char>;

#[llvm_name="pclose"]
@define ssg_pclose(stream: &void) <int>;

const VERSION <string> = "0.1.0";
const MAX_ARGS <int> = 256;
const MAX_FILES <int> = 4096;

// ---------------------------------------------------------------------------
// argv
// ---------------------------------------------------------------------------

struct Argv { args <[string]>, count <int>, ok <bool> }

// Reads /proc/self/cmdline, skips argv[0], splits on NUL. ok=false when
// procfs is unavailable (the caller reports it; never blame).
fun read_argv() <Argv> {
    let argv <Argv> = Argv{ args: new [string, MAX_ARGS]{}, count: 0, ok: false };
    let buf <[char]> = new [char, 4096]{};
    let fd <int> = ssg_open("/proc/self/cmdline", 0);
    if (fd < 0) { delete buf; return argv; }
    let got <long> = ssg_read(fd, &buf[0], cast<ulong>(4096));
    ssg_close(fd);
    if (got <= cast<long>(0)) { delete buf; return argv; }
    let end <int> = cast<int>(got);
    let skip_first <bool> = true;
    let start <int> = 0;
    for (let i <int> = 0; i < end; i++) {
        if (buf[i] == cast<char>(0)) {
            if (i > start) {
                if (skip_first) {
                    skip_first = false;
                } else if (argv.count < MAX_ARGS) {
                    argv.args[argv.count] = from_chars(buf, start, i - start);
                    argv.count = argv.count + 1;
                }
            }
            start = i + 1;
        }
    }
    delete buf;
    argv.ok = true;
    return argv;
}

fun free_argv(argv: &Argv) <noret> {
    for (let i <int> = 0; i < argv.count; i++) {
        free_str(argv.args[i]);
    }
    delete argv.args;
}

// ---------------------------------------------------------------------------
// content/*.md enumeration
// ---------------------------------------------------------------------------

struct FileList { files <[string]>, count <int> }

// Lists *.md entries in `dir` (flat, no recursion). A single quote in the
// directory name is rejected outright so the popen command line cannot be
// injected through. Returns count 0 on any failure (message already printed).
fun list_md_files(dir: string) <FileList> {
    let out <FileList> = FileList{ files: new [string, MAX_FILES]{}, count: 0 };
    if (contains(dir, "'")) {
        printf("error: directory name may not contain a single quote: %s\n", dir);
        return out;
    }
    let cmd <string> = concat(concat("ls -1 -- '", dir), "'");
    let pipe <&void> = ssg_popen(cmd, "r");
    if (pipe == null) {
        printf("error: could not list directory %s\n", dir);
        return out;
    }
    let linebuf <[char]> = new [char, 1024]{};
    while (out.count < MAX_FILES) {
        let got <&char> = ssg_fgets(&linebuf[0], 1024, pipe);
        if (got == null) { break; }
        let n <int> = 0;
        while (n < 1024 && linebuf[n] != cast<char>(0) && linebuf[n] != cast<char>(10)) {
            n = n + 1;
        }
        if (n == 0) { continue; }
        let name <string> = from_chars(linebuf, 0, n);
        if (ends_with(name, ".md")) {
            out.files[out.count] = name;
            out.count = out.count + 1;
        } else {
            free_str(name);
        }
    }
    delete linebuf;
    ssg_pclose(pipe);
    return out;
}

fun free_file_list(fl: &FileList) <noret> {
    for (let i <int> = 0; i < fl.count; i++) {
        free_str(fl.files[i]);
    }
    delete fl.files;
}

// ---------------------------------------------------------------------------
// front matter
// ---------------------------------------------------------------------------

struct PageMeta { title <string>, date <string>, body <string> }

// Splits "---\ntitle: ..\ndate: ..\n---\n<body>" into its parts. No opening
// fence, or no closing fence, means "no front matter": the whole text is the
// body and the title falls back to `fallback_title`.
fun parse_front_matter(text: string, fallback_title: string) <PageMeta> {
    let meta <PageMeta> = PageMeta{ title: fallback_title, date: "", body: text };
    if (!starts_with(text, "---\n")) { return meta; }
    let rest <string> = substr(text, 4, len(text) - 4);
    let total <int> = len(rest);
    let fm <string> = "";
    let closed <bool> = false;
    let body_start <int> = total;
    let i <int> = 0;
    while (i < total) {
        let nl <int> = index_of_char(substr(rest, i, total - i), '\n');
        let line_end <int> = total;
        if (nl >= 0) { line_end = i + nl; }
        let line <string> = trim(substr(rest, i, line_end - i));
        if (equals(line, "---")) {
            closed = true;
            if (nl >= 0) { body_start = line_end + 1; }
            break;
        }
        fm = concat(fm, concat(line, "\n"));
        if (nl < 0) { break; }
        i = line_end + 1;
    }
    if (!closed) { return meta; }
    // Parse "key: value" lines.
    let f <string> = fm;
    while (true) {
        let nl2 <int> = index_of_char(f, '\n');
        if (nl2 < 0) { break; }
        let fl <string> = substr(f, 0, nl2);
        f = substr(f, nl2 + 1, len(f) - nl2 - 1);
        let colon <int> = index_of_char(fl, ':');
        if (colon > 0) {
            let key <string> = trim(substr(fl, 0, colon));
            let val <string> = trim(substr(fl, colon + 1, len(fl) - colon - 1));
            if (equals(key, "title")) { meta.title = val; }
            if (equals(key, "date")) { meta.date = val; }
        }
    }
    meta.body = substr(rest, body_start, total - body_start);
    return meta;
}

// "hello.md" -> "hello" (the .md suffix is the only thing stripped;
// filenames are otherwise used verbatim, so keep them URL-safe).
fun slug_of(filename: string) <string> {
    if (ends_with(filename, ".md")) {
        return substr(filename, 0, len(filename) - 3);
    }
    return filename;
}

// ---------------------------------------------------------------------------
// layout
// ---------------------------------------------------------------------------

fun default_layout() <string> {
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{title}} &mdash; {{site_title}}</title>\n<style>body{max-width:42rem;margin:2rem auto;padding:0 1rem;font-family:system-ui,sans-serif;line-height:1.6}pre{background:#f4f4f4;padding:1rem;overflow:auto}code{background:#f4f4f4;padding:.1rem .3rem}pre code{background:none;padding:0}img{max-width:100%}blockquote{border-left:3px solid #ccc;margin-left:0;padding-left:1rem;color:#555}</style>\n</head>\n<body>\n<main>\n{{content}}\n</main>\n</body>\n</html>\n";
}

fun print_usage() <noret> {
    printf("fin-ssg v%s — static site generator: Markdown in, HTML out.\n\n", VERSION);
    printf("usage: fin-ssg [--content DIR] [--layout DIR] [--out DIR] [--title TITLE]\n\n");
    printf("  --content, -c   content directory with .md files (default: content)\n");
    printf("  --layout, -l    layout directory holding page.html (default: layout)\n");
    printf("  --out, -o       output directory for the HTML files (default: public)\n");
    printf("  --title, -t     site title, used in <title> and index.html (default: My Site)\n");
    printf("  --help, -h      show this help and exit\n\n");
    printf("page.html may use {{site_title}}, {{title}}, {{date}} and {{content}}.\n");
    printf("A Markdown file may start with --- front matter:\n");
    printf("  ---\n  title: My First Post\n  date: 2026-10-20\n  ---\n");
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

struct BuiltPage { slug <string>, title <string>, date <string> }

fun main() <int> {
    let ap <ArgParser> = new_arg_parser("fin-ssg", "Static site generator: Markdown in, HTML out.");
    ap.add_option("--content", "-c", "content", "content directory with .md files");
    ap.add_option("--layout", "-l", "layout", "layout directory holding page.html");
    ap.add_option("--out", "-o", "public", "output directory for the HTML files");
    ap.add_option("--title", "-t", "My Site", "site title for <title> and index.html");
    ap.add_flag("--help", "-h", "show this help and exit");

    let argv <Argv> = read_argv();
    if (!argv.ok) {
        printf("error: cannot read /proc/self/cmdline (Linux procfs required)\n");
        return 1;
    }
    if (!ap.parse(argv.args, argv.count)) {
        printf("error: %s\n\n", ap.error_msg);
        print_usage();
        free_argv(&argv);
        free_arg_parser(ap);
        return 1;
    }
    if (ap.get_flag("--help")) {
        print_usage();
        free_argv(&argv);
        free_arg_parser(ap);
        return 0;
    }
    let content_dir <string> = ap.get_option("--content");
    let layout_dir <string> = ap.get_option("--layout");
    let out_dir <string> = ap.get_option("--out");
    let site_title <string> = ap.get_option("--title");

    if (!is_dir(content_dir)) {
        printf("error: content directory not found: %s\n", content_dir);
        free_argv(&argv);
        free_arg_parser(ap);
        return 1;
    }

    let layout_path <string> = concat(concat(layout_dir, "/"), "page.html");
    let layout <string> = default_layout();
    if (is_file(layout_path)) {
        let lt? <string> = read_to_string(layout_path);
        if (lt == null) {
            printf("warn: could not read %s; using the built-in layout\n", layout_path);
        } else {
            // The file buffer becomes the layout; it outlives this scope,
            // so it is intentionally not freed (short-lived CLI).
            layout = lt?;
        }
    }

    let files <FileList> = list_md_files(content_dir);
    if (files.count == 0) {
        printf("error: no .md files found in %s\n", content_dir);
        free_file_list(&files);
        free_argv(&argv);
        free_arg_parser(ap);
        return 1;
    }

    if (!is_dir(out_dir)) {
        if (!create_dir(out_dir)) {
            printf("error: could not create output directory %s\n", out_dir);
            free_file_list(&files);
            free_argv(&argv);
            free_arg_parser(ap);
            return 1;
        }
    }

    let built <[BuiltPage]> = new [BuiltPage, MAX_FILES]{};
    let built_n <int> = 0;
    let failed <int> = 0;
    for (let i <int> = 0; i < files.count; i++) {
        let name <string> = files.files[i];
        let src <string> = concat(concat(content_dir, "/"), name);
        let raw? <string> = read_to_string(src);
        if (raw == null) {
            printf("warn: skipping unreadable file %s\n", src);
            failed = failed + 1;
            continue;
        }
        let text <string> = raw?;
        let slug <string> = slug_of(name);
        let meta <PageMeta> = parse_front_matter(text, slug);
        let html_body <string> = md_to_html(meta.body);
        let page <string> = tpl_render(layout, md_escape_html(site_title), md_escape_html(meta.title), md_escape_html(meta.date), html_body);
        let dest <string> = concat(concat(concat(out_dir, "/"), slug), ".html");
        if (!write_string(dest, page)) {
            printf("warn: could not write %s\n", dest);
            failed = failed + 1;
        } else {
            built[built_n] = BuiltPage{ slug: slug, title: meta.title, date: meta.date };
            built_n = built_n + 1;
            printf("built %s -> %s\n", src, dest);
        }
        free_file_content(raw);
    }

    // index.html: one link per built page.
    let items <string> = "";
    for (let j <int> = 0; j < built_n; j++) {
        let li <string> = concat("<li><a href=\"", concat(built[j].slug, concat(".html\">", concat(md_escape_html(built[j].title), "</a>"))));
        if (!equals(built[j].date, "")) {
            li = concat(li, concat(" <span class=\"date\">", concat(md_escape_html(built[j].date), "</span>")));
        }
        items = concat(items, concat(li, "</li>\n"));
    }
    let index_body <string> = concat(concat("<h1>", md_escape_html(site_title)), concat("</h1>\n<ul>\n", concat(items, "</ul>\n")));
    let index_page <string> = tpl_render(layout, md_escape_html(site_title), md_escape_html(site_title), "", index_body);
    let index_dest <string> = concat(out_dir, "/index.html");
    if (!write_string(index_dest, index_page)) {
        printf("error: could not write %s\n", index_dest);
        free_file_list(&files);
        free_argv(&argv);
        free_arg_parser(ap);
        return 1;
    }

    printf("fin-ssg: %d page(s) + index -> %s/ (%d skipped)\n", built_n, out_dir, failed);
    delete built;
    free_file_list(&files);
    free_argv(&argv);
    free_arg_parser(ap);
    if (failed > 0) { return 2; }
    return 0;
}
