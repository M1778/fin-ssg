// Native Fin SSG. Linux/procfs required. Content and layout files are read
// through nofollow directory descriptors; publication is atomic per file.
import { ArgParser, new_arg_parser, free_arg_parser } from argparse::std;
import { walk_dir } from fs::std;
import { len, equals, ends_with, substr, concat, clone, to_lower, to_chars, from_chars, free_str, compare } from strings::std;
import { TextBuffer, text_buffer, text_char, text_append, text_finish, md_to_html, md_escape_into, filename_url } from markdown::fin;
import { tpl_render } from template::fin;

#[llvm_name="open"]
@define ssg_open(path: string, flags: int) <int>;
#[llvm_name="openat"]
@define ssg_openat(dir: int, path: string, flags: int, mode: int) <int>;
#[llvm_name="read"]
@define ssg_read(fd: int, buf: &char, count: ulong) <long>;
#[llvm_name="write"]
@define ssg_write(fd: int, buf: &char, count: ulong) <long>;
#[llvm_name="close"]
@define ssg_close(fd: int) <int>;
#[llvm_name="mkdirat"]
@define ssg_mkdirat(fd: int, path: string, mode: int) <int>;
#[llvm_name="renameat"]
@define ssg_renameat(old_dir: int, old: string, new_dir: int, dest: string) <int>;
#[llvm_name="unlinkat"]
@define ssg_unlinkat(dir: int, path: string, flags: int) <int>;
#[llvm_name="fsync"]
@define ssg_fsync(fd: int) <int>;
#[llvm_name="statx"]
@define ssg_statx(fd: int, path: string, flags: int, mask: uint, buf: &char) <int>;
#[llvm_name="__errno_location"]
@define ssg_errno() <&int>;
#[llvm_name="getpid"]
@define ssg_pid() <int>;

const MAX_ARGS <int> = 256;
const MAX_ARG_BYTES <int> = 65536;
const MAX_FILES <int> = 4096;
const MAX_INPUT <int> = 4194304;
// Linux O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC.
const DIR_FLAGS <int> = 720896;
// O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC.
const READ_FLAGS <int> = 657408;

struct Argv { args <[string]>, count <int>, ok <bool> }
fun read_argv() <Argv> {
    let result <Argv> = Argv{args: new [string, MAX_ARGS]{}, count: 0, ok: false};
    let buf <[char]> = new [char, MAX_ARG_BYTES + 1]{};
    let fd <int> = ssg_open("/proc/self/cmdline", 524288);
    if (fd < 0) { delete buf; return result; }
    let used <int> = 0;
    let good <bool> = true;
    while (used <= MAX_ARG_BYTES) {
        let got <long> = ssg_read(fd, &buf[used], cast<ulong>(MAX_ARG_BYTES + 1 - used));
        if (got < cast<long>(0)) {
            if (*ssg_errno() == 4) { continue; }
            good = false; break;
        }
        if (got == cast<long>(0)) { break; }
        used = used + cast<int>(got);
    }
    ssg_close(fd);
    if (!good || used == 0 || used > MAX_ARG_BYTES || buf[used - 1] != cast<char>(0)) { delete buf; return result; }
    let start <int> = 0;
    let first <bool> = true;
    for (let i <int> = 0; i < used; i++) {
        if (buf[i] == cast<char>(0)) {
            if (first) { first = false; }
            else {
                if (result.count == MAX_ARGS) { delete buf; return result; }
                let value <string> = from_chars(buf, start, i - start);
                result.args[result.count] = value; result.count++;
            }
            start = i + 1;
        }
    }
    delete buf; result.ok = true; return result;
}
fun free_argv(argv: &Argv) <noret> {
    for (let i <int> = 0; i < argv.count; i++) { free_str(argv.args[i]); }
    delete argv.args;
}

// Walk every path component without following symlinks, including ancestors.
// '..' is deliberately refused. The returned fd pins the final directory.
fun open_directory(path: string, create: bool) <int> {
    let chars <[char]> = to_chars(path);
    let total <int> = chars.length - 1;
    if (total == 0) { delete chars; *ssg_errno() = 22; return -1; }
    let base <string> = ".";
    if (chars[0] == '/') { base = "/"; }
    let fd <int> = ssg_open(base, DIR_FLAGS);
    let i <int> = 0;
    while (fd >= 0 && i < total) {
        while (i < total && chars[i] == '/') { i++; }
        let start <int> = i;
        while (i < total && chars[i] != '/') { i++; }
        if (start == i) { break; }
        let part <string> = from_chars(chars, start, i - start);
        if (equals(part, ".")) { free_str(part); continue; }
        if (equals(part, "..")) { free_str(part); ssg_close(fd); fd = -1; *ssg_errno() = 22; break; }
        let next <int> = ssg_openat(fd, part, DIR_FLAGS, 0);
        if (next < 0 && create && *ssg_errno() == 2) {
            ssg_mkdirat(fd, part, 493);
            next = ssg_openat(fd, part, DIR_FLAGS, 0);
        }
        free_str(part); ssg_close(fd); fd = next;
    }
    delete chars; return fd;
}

// statx has a stable Linux ABI: stx_mode is a 16-bit field at byte 28.
// Returns 1 regular, 0 missing, -1 special/symlink/error. AT_EMPTY_PATH
// validates the already-open descriptor, avoiding check/open races.
fun regular_file(fd: int, path: string, empty: bool) <int> {
    let bytes <[char]> = new [char, 256]{};
    let flags <int> = 256;
    if (empty) { flags = flags + 4096; }
    let status <int> = ssg_statx(fd, path, flags, cast<uint>(1), &bytes[0]);
    if (status < 0) {
        let missing <bool> = *ssg_errno() == 2;
        delete bytes;
        if (missing) { return 0; }
        return -1;
    }
    let mode <int> = (cast<int>(bytes[28]) & 255) + (cast<int>(bytes[29]) & 255) * 256;
    delete bytes;
    if ((mode & 61440) == 32768) { return 1; }
    return -1;
}

fun? read_file(fd: int, name: string) <string> {
    let file <int> = ssg_openat(fd, name, READ_FLAGS, 0);
    if (file < 0) { return null; }
    if (regular_file(file, "", true) != 1) { ssg_close(file); return null; }
    let buf <[char]> = new [char, MAX_INPUT + 1]{};
    let used <int> = 0;
    let ok <bool> = true;
    while (used <= MAX_INPUT) {
        let got <long> = ssg_read(file, &buf[used], cast<ulong>(MAX_INPUT + 1 - used));
        if (got < cast<long>(0)) { if (*ssg_errno() == 4) { continue; } ok = false; break; }
        if (got == cast<long>(0)) { break; }
        used = used + cast<int>(got);
    }
    if (ssg_close(file) != 0) { ok = false; }
    if (used > MAX_INPUT) { ok = false; }
    // NUL cannot be represented in Fin string input; never silently discard it.
    for (let i <int> = 0; ok && i < used; i++) { if (buf[i] == cast<char>(0)) { ok = false; } }
    if (!ok) { delete buf; return null; }
    let text <string> = from_chars(buf, 0, used);
    delete buf; return text;
}

// Exclusive temp creation and rename relative to the same pinned directory.
// Reject existing special files. A raced-in symlink is replaced, never followed.
fun atomic_write(dir: int, dest: string, text: string) <bool> {
    if (regular_file(dir, dest, false) < 0) { return false; }
    let temp <string> = "";
    let fd <int> = -1;
    for (let attempt <int> = 0; attempt < 128; attempt++) {
        temp = format!(".fin-ssg-{}-{}.tmp", ssg_pid(), attempt);
        // WRONLY|CREAT|EXCL|NOFOLLOW|CLOEXEC; mode 0644 respects umask.
        fd = ssg_openat(dir, temp, 655553, 420);
        if (fd >= 0) { break; }
        let exists <bool> = *ssg_errno() == 17;
        free_str(temp);
        if (!exists) { return false; }
    }
    if (fd < 0) { return false; }
    let chars <[char]> = to_chars(text);
    let count <int> = chars.length - 1;
    let done <int> = 0;
    let ok <bool> = true;
    while (done < count) {
        let wrote <long> = ssg_write(fd, &chars[done], cast<ulong>(count - done));
        if (wrote < cast<long>(0) && *ssg_errno() == 4) { continue; }
        if (wrote <= cast<long>(0)) { ok = false; break; }
        done = done + cast<int>(wrote);
    }
    delete chars;
    if (ok && ssg_fsync(fd) != 0) { ok = false; }
    if (ssg_close(fd) != 0) { ok = false; }
    if (ok && regular_file(dir, dest, false) < 0) { ok = false; }
    if (ok && ssg_renameat(dir, temp, dir, dest) != 0) { ok = false; }
    if (!ok) { ssg_unlinkat(dir, temp, 0); }
    else if (ssg_fsync(dir) != 0) { ok = false; }
    free_str(temp); return ok;
}

struct FileList { files <[string]>, count <int>, ok <bool> }
fun list_md_files(fd: int) <FileList> {
    let path <string> = format!("/proc/self/fd/{}", fd);
    let entries <[string]> = walk_dir(path);
    free_str(path);
    let list <FileList> = FileList{files: new [string, MAX_FILES]{}, count: 0, ok: true};
    for (let i <int> = 0; i < entries.length; i++) {
        let name <string> = entries[i];
        if (name == null) { list.ok = false; continue; }
        if (ends_with(name, ".md")) {
            if (list.count == MAX_FILES) { list.ok = false; free_str(name); }
            else { list.files[list.count] = name; list.count++; }
        } else { free_str(name); }
    }
    delete entries;
    // Insertion sort is bounded at 4096 filenames and preserves deterministic output.
    for (let i <int> = 1; i < list.count; i++) {
        let name <string> = list.files[i]; let j <int> = i;
        while (j > 0 && compare(list.files[j - 1], name) > 0) { list.files[j] = list.files[j - 1]; j--; }
        list.files[j] = name;
    }
    return list;
}
fun free_files(list: &FileList) <noret> {
    for (let i <int> = 0; i < list.count; i++) { free_str(list.files[i]); }
    delete list.files;
}

struct PageMeta { title <string>, date <string>, body <string> }
fun blank(c: char) <bool> { return c == ' ' || c == '\t' || c == '\r'; }
fun parse_front_matter(text: string, fallback: string) <PageMeta> {
    let meta <PageMeta> = PageMeta{title: clone(fallback), date: clone(""), body: clone(text)};
    let chars <[char]> = to_chars(text);
    let total <int> = chars.length - 1;
    let first <int> = 0;
    while (first < total && chars[first] != '\n') { first++; }
    let opening <int> = first;
    if (opening > 0 && chars[opening - 1] == '\r') { opening--; }
    if (opening != 3 || chars[0] != '-' || chars[1] != '-' || chars[2] != '-' || first == total) { delete chars; return meta; }
    let close <int> = -1;
    let body <int> = total;
    let i <int> = first + 1;
    while (i < total) {
        let end <int> = i;
        while (end < total && chars[end] != '\n') { end++; }
        let left <int> = i; let right <int> = end;
        while (left < right && blank(chars[left])) { left++; }
        while (right > left && blank(chars[right - 1])) { right--; }
        if (right - left == 3 && chars[left] == '-' && chars[left + 1] == '-' && chars[left + 2] == '-') { close = i; body = end; if (body < total) { body++; } break; }
        i = end + 1;
    }
    if (close < 0) { delete chars; return meta; }
    i = first + 1;
    while (i < close) {
        let end <int> = i;
        while (end < close && chars[end] != '\n') { end++; }
        let colon <int> = i;
        while (colon < end && chars[colon] != ':') { colon++; }
        if (colon < end) {
            let left <int> = i; let right <int> = colon;
            while (left < right && blank(chars[left])) { left++; }
            while (right > left && blank(chars[right - 1])) { right--; }
            let key <string> = from_chars(chars, left, right - left);
            left = colon + 1; right = end;
            while (left < right && blank(chars[left])) { left++; }
            while (right > left && blank(chars[right - 1])) { right--; }
            if (equals(key, "title")) { free_str(meta.title); meta.title = from_chars(chars, left, right - left); }
            else if (equals(key, "date")) { free_str(meta.date); meta.date = from_chars(chars, left, right - left); }
            free_str(key);
        }
        i = end + 1;
    }
    free_str(meta.body); meta.body = from_chars(chars, body, total - body);
    delete chars; return meta;
}
fun free_meta(meta: &PageMeta) <noret> { free_str(meta.title); free_str(meta.date); free_str(meta.body); }
fun default_layout() <string> {
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{title}} &mdash; {{site_title}}</title>\n<style>body{max-width:42rem;margin:2rem auto;padding:0 1rem;font-family:system-ui,sans-serif;line-height:1.6}pre{background:#f4f4f4;padding:1rem;overflow:auto}code{background:#f4f4f4;padding:.1rem .3rem}pre code{background:none;padding:0}img{max-width:100%}blockquote{border-left:3px solid #ccc;margin-left:0;padding-left:1rem;color:#555}</style>\n</head>\n<body>\n<main>\n{{content}}\n</main>\n</body>\n</html>\n";
}
fun print_usage() <noret> {
    printf("fin-ssg v0.1.0 — native Fin static site generator\n");
    printf("usage: fin-ssg [--content DIR] [--layout DIR] [--out DIR] [--title TITLE]\n");
    printf("Aliases: -c, -l, -o, -t; --help/-h. Defaults: content, layout, public, My Site.\n");
    printf("Limits: 256 arguments / 65536 argv bytes, 4096 Markdown files, 4 MiB per input, 32 MiB per rendered output.\n");
    printf("Linux/procfs/statx required; symlink paths and '..' components refused. Layouts are trusted HTML.\n");
}

// Reserve the generated homepage and reject ASCII case-folded collisions so
// output remains portable to case-insensitive filesystems and static hosts.
fun safe_names(files: &FileList) <bool> {
    let keys <[string]> = new [string, files.count]{};
    let ok <bool> = true;
    for (let i <int> = 0; i < files.count; i++) {
        let key <string> = to_lower(files.files[i]);
        keys[i] = key;
        if (equals(keys[i], "index.md")) { ok = false; }
    }
    for (let i <int> = 1; i < files.count; i++) {
        let key <string> = keys[i]; let j <int> = i;
        while (j > 0 && compare(keys[j - 1], key) > 0) { keys[j] = keys[j - 1]; j--; }
        keys[j] = key;
    }
    for (let i <int> = 1; i < files.count; i++) {
        if (equals(keys[i - 1], keys[i])) { ok = false; }
    }
    for (let i <int> = 0; i < files.count; i++) { free_str(keys[i]); }
    delete keys;
    return ok;
}

fun build_site(content: string, layout_dir: string, out: string, title: string) <int> {
    let input <int> = open_directory(content, false);
    if (input < 0) { printf("error: content must be a readable, non-symlink directory: %s\n", content); return 1; }
    let files <FileList> = list_md_files(input);
    if (!files.ok || files.count == 0) {
        printf("error: content listing failed, is empty, or exceeds 4096 Markdown files\n");
        free_files(&files); ssg_close(input); return 1;
    }
    // Preflight all reserved names before making any output changes.
    if (!safe_names(&files)) {
        printf("error: index.md is reserved; output names must be unique ignoring ASCII case\n");
        free_files(&files); ssg_close(input); return 1;
    }
    let layout <string> = clone(default_layout());
    let layout_fd <int> = open_directory(layout_dir, false);
    let layout_error <bool> = false;
    if (layout_fd < 0) {
        if (*ssg_errno() != 2) { layout_error = true; }
    } else {
        let state <int> = regular_file(layout_fd, "page.html", false);
        if (state < 0) { layout_error = true; }
        else if (state == 1) {
            let value? <string> = read_file(layout_fd, "page.html");
            if (value == null) { layout_error = true; }
            else { free_str(layout); layout = value?; }
        }
        ssg_close(layout_fd);
    }
    if (layout_error) {
        printf("error: unsafe/unreadable layout or input exceeds 4 MiB\n");
        free_str(layout); free_files(&files); ssg_close(input); return 1;
    }
    let output <int> = open_directory(out, true);
    if (output < 0) {
        printf("error: cannot open/create non-symlink output directory: %s\n", out);
        free_str(layout); free_files(&files); ssg_close(input); return 1;
    }
    let safe <bool> = regular_file(output, "index.html", false) >= 0;
    for (let i <int> = 0; safe && i < files.count; i++) {
        let slug <string> = substr(files.files[i], 0, len(files.files[i]) - 3);
        let dest <string> = concat(slug, ".html");
        if (regular_file(output, dest, false) < 0) { printf("error: unsafe output file: %s\n", dest); safe = false; }
        free_str(dest); free_str(slug);
    }
    if (!safe) {
        printf("error: output preflight refused a symlink/special file\n");
        ssg_close(output); free_str(layout); free_files(&files); ssg_close(input); return 1;
    }
    let index <TextBuffer> = text_buffer();
    text_append(&index, "<h1>"); md_escape_into(&index, title); text_append(&index, "</h1>\n<ul>\n");
    let built <int> = 0; let failed <int> = 0;
    for (let i <int> = 0; i < files.count; i++) {
        let name <string> = files.files[i];
        let raw? <string> = read_file(input, name);
        if (raw == null) { printf("warn: unreadable/special/symlink/NUL-containing or >4 MiB input: %s\n", name); failed++; continue; }
        let slug <string> = substr(name, 0, len(name) - 3);
        let dest <string> = concat(slug, ".html");
        let meta <PageMeta> = parse_front_matter(raw?, slug);
        free_str(raw?);
        let fragment? <string> = md_to_html(meta.body);
        let page? <string> = null;
        if (fragment != null) { page = tpl_render(layout, title, meta.title, meta.date, fragment?); free_str(fragment?); }
        let ok <bool> = false;
        if (page != null) { ok = atomic_write(output, dest, page?); free_str(page?); }
        if (!ok) { printf("warn: rendering limit or publication failure: %s\n", name); failed++; }
        else {
            built++;
            text_append(&index, "<li><a href=\""); filename_url(&index, dest); text_append(&index, "\">"); md_escape_into(&index, meta.title); text_append(&index, "</a>");
            if (len(meta.date) > 0) { text_append(&index, " <span class=\"date\">"); md_escape_into(&index, meta.date); text_append(&index, "</span>"); }
            text_append(&index, "</li>\n");
            printf("built %s -> %s\n", name, dest);
        }
        free_meta(&meta); free_str(dest); free_str(slug);
    }
    text_append(&index, "</ul>\n");
    let body? <string> = text_finish(&index);
    let index_ok <bool> = false;
    if (body != null) {
        let page? <string> = tpl_render(layout, title, title, "", body?);
        free_str(body?);
        if (page != null) { index_ok = atomic_write(output, "index.html", page?); free_str(page?); }
    }
    ssg_close(output); ssg_close(input); free_str(layout); free_files(&files);
    if (!index_ok) { printf("error: index rendering limit or publication failure\n"); return 1; }
    printf("fin-ssg: %d page(s) + index -> %s/ (%d skipped)\n", built, out, failed);
    if (failed > 0) { return 2; }
    return 0;
}

fun main() <int> {
    let ap <ArgParser> = new_arg_parser("fin-ssg", "Static site generator");
    ap.add_option("--content", "-c", "content", "content directory");
    ap.add_option("--layout", "-l", "layout", "layout directory");
    ap.add_option("--out", "-o", "public", "output directory");
    ap.add_option("--title", "-t", "My Site", "site title");
    ap.add_flag("--help", "-h", "show help");
    let argv <Argv> = read_argv();
    let result <int> = 1;
    if (!argv.ok) { printf("error: cannot read complete argv (Linux procfs; max 256 args / 65536 bytes)\n"); }
    else if (!ap.parse(argv.args, argv.count)) { printf("error: %s\n", ap.error_msg); }
    else if (ap.get_positional_count() != 0) { printf("error: unexpected positional argument\n"); }
    else if (ap.get_flag("--help")) { print_usage(); result = 0; }
    else { result = build_site(ap.get_option("--content"), ap.get_option("--layout"), ap.get_option("--out"), ap.get_option("--title")); }
    free_argv(&argv); free_arg_parser(ap); return result;
}
