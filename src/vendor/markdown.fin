// VENDORED — native Fin Markdown subset and bounded, amortized text buffers.
// Generated HTML is never reparsed as Markdown. All returned strings are owned.
import { len, to_chars, from_chars, free_str } from strings::std;
namespace fin {

pub struct TextBuffer { bytes <[char]>, used <int>, ok <bool> }

pub fun text_buffer() <TextBuffer> {
    return TextBuffer{bytes: new [char, 1024]{}, used: 0, ok: true};
}

pub fun text_reserve(b: &TextBuffer, extra: int) <bool> {
    if (!b.ok) { return false; }
    if (extra < 0 || extra > 33554432 - b.used) { b.ok = false; return false; }
    let need <int> = b.used + extra;
    if (need <= b.bytes.length) { return true; }
    let capacity <int> = b.bytes.length;
    while (capacity < need) { capacity = capacity * 2; }
    let grown <[char]> = new [char, capacity]{};
    for (let i <int> = 0; i < b.used; i++) { grown[i] = b.bytes[i]; }
    delete b.bytes;
    b.bytes = grown;
    return true;
}

pub fun text_char(b: &TextBuffer, c: char) <noret> {
    if (text_reserve(b, 1)) { b.bytes[b.used] = c; b.used++; }
}

pub fun text_range(b: &TextBuffer, chars: [char], start: int, end: int) <noret> {
    if (!text_reserve(b, end - start)) { return; }
    for (let i <int> = start; i < end; i++) { b.bytes[b.used] = chars[i]; b.used++; }
}

pub fun text_append(b: &TextBuffer, s: string) <noret> {
    let chars <[char]> = to_chars(s);
    text_range(b, chars, 0, chars.length - 1);
    delete chars;
}

pub fun? text_finish(b: &TextBuffer) <string> {
    if (!b.ok) { delete b.bytes; return null; }
    let result <string> = from_chars(b.bytes, 0, b.used);
    delete b.bytes;
    return result;
}

fun escape_char(b: &TextBuffer, c: char) <noret> {
    if (c == '&') { text_append(b, "&amp;"); }
    else if (c == '<') { text_append(b, "&lt;"); }
    else if (c == '>') { text_append(b, "&gt;"); }
    else if (c == '"') { text_append(b, "&quot;"); }
    else if (c == '\'') { text_append(b, "&#39;"); }
    else { text_char(b, c); }
}

fun escape_range(b: &TextBuffer, chars: [char], start: int, end: int) <noret> {
    for (let i <int> = start; i < end; i++) { escape_char(b, chars[i]); }
}

pub fun md_escape_into(b: &TextBuffer, s: string) <noret> {
    let chars <[char]> = to_chars(s);
    escape_range(b, chars, 0, chars.length - 1);
    delete chars;
}

fun lower(c: char) <char> {
    if (c >= 'A' && c <= 'Z') { return cast<char>(cast<int>(c) + 32); }
    return c;
}

fun matches(chars: [char], pos: int, end: int, token: string) <bool> {
    let t <[char]> = to_chars(token);
    let n <int> = t.length - 1;
    let same <bool> = pos + n <= end;
    for (let i <int> = 0; same && i < n; i++) {
        if (chars[pos + i] != t[i]) { same = false; }
    }
    delete t;
    return same;
}

fun scheme_is(chars: [char], start: int, end: int, token: string) <bool> {
    let t <[char]> = to_chars(token);
    let same <bool> = end - start == t.length - 1;
    for (let i <int> = 0; same && i < t.length - 1; i++) {
        if (lower(chars[start + i]) != t[i]) { same = false; }
    }
    delete t;
    return same;
}

fun hex_value(c: char) <int> {
    if (c >= '0' && c <= '9') { return cast<int>(c) - cast<int>('0'); }
    let lc <char> = lower(c);
    if (lc >= 'a' && lc <= 'f') { return cast<int>(lc) - cast<int>('a') + 10; }
    return -1;
}

// Scheme allowlist, not a blacklist. Entity-like scheme spellings and encoded
// controls/structural separators are rejected, including nested percent escapes.
fun safe_url(chars: [char], start: int, end: int, image: bool) <bool> {
    if (start == end) { return false; }
    if (end - start >= 2 && chars[start] == '/' && chars[start + 1] == '/') { return false; }
    let scheme_end <int> = -1;
    let prefix <bool> = true;
    for (let i <int> = start; i < end; i++) {
        let c <char> = chars[i];
        let byte <int> = cast<int>(c) & 255;
        if (byte <= 32 || byte == 127 || c == '\\') { return false; }
        if (c == '&' && (prefix || matches(chars, i, end, "&#") || matches(chars, i, end, "&colon;") || matches(chars, i, end, "&Tab;") || matches(chars, i, end, "&NewLine;"))) { return false; }
        if (c == '%') {
            if (i + 2 >= end) { return false; }
            let hi <int> = hex_value(chars[i + 1]);
            let lo <int> = hex_value(chars[i + 2]);
            if (hi < 0 || lo < 0) { return false; }
            let decoded <int> = hi * 16 + lo;
            if (decoded < 32 || decoded == 127 || decoded == 37 || decoded == 58 || decoded == 92 || decoded == 38) { return false; }
            // A percent escape cannot be part of an explicit scheme.
            if (prefix && scheme_end < 0) {
                let j <int> = i + 3;
                while (j < end && chars[j] != '/' && chars[j] != '?' && chars[j] != '#') {
                    if (chars[j] == ':') { return false; }
                    j++;
                }
                prefix = false;
            }
            i = i + 2;
        } else if (prefix && c == ':') { scheme_end = i; prefix = false; }
        else if (c == '/' || c == '?' || c == '#') { prefix = false; }
    }
    if (scheme_end < 0) { return true; }
    return scheme_is(chars, start, scheme_end, "http") || scheme_is(chars, start, scheme_end, "https") || (!image && scheme_is(chars, start, scheme_end, "mailto"));
}

// Percent-encode UTF-8 filename bytes as a single relative URL path segment.
pub fun filename_url(b: &TextBuffer, name: string) <noret> {
    let chars <[char]> = to_chars(name);
    let digits <[char]> = to_chars("0123456789ABCDEF");
    for (let i <int> = 0; i < chars.length - 1; i++) {
        let c <char> = chars[i];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') { text_char(b, c); }
        else {
            let value <int> = cast<int>(c) & 255;
            text_char(b, '%'); text_char(b, digits[value / 16]); text_char(b, digits[value % 16]);
        }
    }
    delete chars;
    delete digits;
}

fun find_char(chars: [char], start: int, end: int, c: char) <int> {
    for (let i <int> = start; i < end; i++) { if (chars[i] == c) { return i; } }
    return -1;
}

fun find_pair(chars: [char], start: int, end: int, a: char, b: char) <int> {
    for (let i <int> = start; i + 1 < end; i++) { if (chars[i] == a && chars[i + 1] == b) { return i; } }
    return -1;
}

// Consumed spans are not rescanned. Failed delimiter searches are remembered;
// nesting is bounded, so malformed input cannot trigger quadratic suffix scans.
fun inline_range(b: &TextBuffer, chars: [char], start: int, end: int, depth: int) <noret> {
    if (depth >= 16) { escape_range(b, chars, start, end); return; }
    let code_possible <bool> = true;
    let links_possible <bool> = true;
    let bold_possible <bool> = true;
    let italic_possible <bool> = true;
    let i <int> = start;
    while (i < end && b.ok) {
        let c <char> = chars[i];
        if (c == '`' && code_possible) {
            let close <int> = find_char(chars, i + 1, end, '`');
            if (close >= 0) {
                text_append(b, "<code>"); escape_range(b, chars, i + 1, close); text_append(b, "</code>");
                i = close + 1; continue;
            }
            code_possible = false;
        }
        let image <bool> = c == '!' && i + 1 < end && chars[i + 1] == '[';
        if ((image || c == '[') && links_possible) {
            let label <int> = i + 1;
            if (image) { label++; }
            let middle <int> = find_pair(chars, label, end, ']', '(');
            if (middle < 0) { links_possible = false; }
            else {
                let close <int> = find_char(chars, middle + 2, end, ')');
                if (close < 0) { links_possible = false; }
                else {
                    if (safe_url(chars, middle + 2, close, image)) {
                        if (image) { text_append(b, "<img src=\""); }
                        else { text_append(b, "<a href=\""); }
                        escape_range(b, chars, middle + 2, close);
                        if (image) {
                            text_append(b, "\" alt=\""); escape_range(b, chars, label, middle); text_append(b, "\">");
                        } else {
                            text_append(b, "\">"); escape_range(b, chars, label, middle); text_append(b, "</a>");
                        }
                    } else { escape_range(b, chars, i, close + 1); }
                    i = close + 1; continue;
                }
            }
        }
        if (c == '*') {
            let bold <bool> = i + 1 < end && chars[i + 1] == '*';
            let close <int> = -1;
            let width <int> = 1;
            if (bold && bold_possible) {
                width = 2;
                close = find_pair(chars, i + 2, end, '*', '*');
                if (close < 0) { bold_possible = false; }
            } else if (!bold && italic_possible) {
                close = find_char(chars, i + 1, end, '*');
                if (close < 0) { italic_possible = false; }
            }
            if (close > i + width) {
                if (bold) { text_append(b, "<strong>"); } else { text_append(b, "<em>"); }
                inline_range(b, chars, i + width, close, depth + 1);
                if (bold) { text_append(b, "</strong>"); } else { text_append(b, "</em>"); }
                i = close + width; continue;
            }
        }
        escape_char(b, c); i++;
    }
}

struct MDState { html <TextBuffer>, para <TextBuffer>, in_code <bool>, list <int>, in_quote <bool> }

fun close_para(st: &MDState) <noret> {
    if (!st.para.ok) { st.html.ok = false; }
    if (st.para.used > 0) {
        text_append(&st.html, "<p>");
        inline_range(&st.html, st.para.bytes, 0, st.para.used, 0);
        text_append(&st.html, "</p>\n");
        st.para.used = 0;
    }
}
fun close_list(st: &MDState) <noret> {
    if (st.list == 1) { text_append(&st.html, "</ul>\n"); }
    if (st.list == 2) { text_append(&st.html, "</ol>\n"); }
    st.list = 0;
}
fun close_in_quote(st: &MDState) <noret> {
    if (st.in_quote) { text_append(&st.html, "</blockquote>\n"); st.in_quote = false; }
}
fun close_all(st: &MDState) <noret> { close_para(st); close_list(st); close_in_quote(st); }
fun whitespace(c: char) <bool> { return c == ' ' || c == '\t' || c == '\r'; }

pub fun? md_to_html(md: string) <string> {
    let chars <[char]> = to_chars(md);
    let total <int> = chars.length - 1;
    let st <MDState> = MDState{html: text_buffer(), para: text_buffer(), in_code: false, list: 0, in_quote: false};
    let start <int> = 0;
    while (start < total && st.html.ok && st.para.ok) {
        let end <int> = start;
        while (end < total && chars[end] != '\n') { end++; }
        let raw_end <int> = end;
        if (raw_end > start && chars[raw_end - 1] == '\r') { raw_end--; }
        let left <int> = start;
        let right <int> = raw_end;
        while (left < right && whitespace(chars[left])) { left++; }
        while (right > left && whitespace(chars[right - 1])) { right--; }
        let fence <bool> = matches(chars, left, right, "```");
        if (st.in_code) {
            if (fence && right - left == 3) { text_append(&st.html, "</code></pre>\n"); st.in_code = false; }
            else { escape_range(&st.html, chars, start, raw_end); text_char(&st.html, '\n'); }
        } else if (left == right) { close_all(&st); }
        else if (fence) { close_all(&st); text_append(&st.html, "<pre><code>\n"); st.in_code = true; }
        else if (right - left == 3 && matches(chars, left, right, "---")) { close_all(&st); text_append(&st.html, "<hr>\n"); }
        else if (chars[left] == '>') {
            close_para(&st); close_list(&st);
            if (!st.in_quote) { text_append(&st.html, "<blockquote>\n"); st.in_quote = true; }
            left++;
            while (left < right && whitespace(chars[left])) { left++; }
            text_append(&st.html, "<p>"); inline_range(&st.html, chars, left, right, 0); text_append(&st.html, "</p>\n");
        } else {
            close_in_quote(&st);
            let heading <int> = 0;
            while (left + heading < right && chars[left + heading] == '#' && heading < 4) { heading++; }
            if (heading > 3 || heading == 0 || left + heading >= right || chars[left + heading] != ' ') { heading = 0; }
            let list <int> = 0;
            let item <int> = left;
            if (left + 1 < right && (chars[left] == '-' || chars[left] == '*') && chars[left + 1] == ' ') { list = 1; item = left + 2; }
            else {
                let digit <int> = left;
                while (digit < right && chars[digit] >= '0' && chars[digit] <= '9') { digit++; }
                if (digit > left && digit + 1 < right && chars[digit] == '.' && chars[digit + 1] == ' ') { list = 2; item = digit + 2; }
            }
            if (heading > 0) {
                close_all(&st);
                text_append(&st.html, "<h"); text_char(&st.html, cast<char>(cast<int>('0') + heading)); text_char(&st.html, '>');
                inline_range(&st.html, chars, left + heading + 1, right, 0);
                text_append(&st.html, "</h"); text_char(&st.html, cast<char>(cast<int>('0') + heading)); text_append(&st.html, ">\n");
            } else if (list > 0) {
                close_para(&st);
                if (st.list != list) {
                    close_list(&st); st.list = list;
                    if (list == 1) { text_append(&st.html, "<ul>\n"); } else { text_append(&st.html, "<ol>\n"); }
                }
                text_append(&st.html, "<li>"); inline_range(&st.html, chars, item, right, 0); text_append(&st.html, "</li>\n");
            } else {
                close_list(&st);
                if (st.para.used > 0) { text_char(&st.para, '\n'); }
                text_range(&st.para, chars, left, right);
            }
        }
        start = end + 1;
    }
    if (st.in_code) { text_append(&st.html, "</code></pre>\n"); }
    close_all(&st);
    delete st.para.bytes;
    delete chars;
    return text_finish(&st.html);
}
}
