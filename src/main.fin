import { ArgParser, new_arg_parser, free_arg_parser } from argparse::std;
import { walk_dir } from fs::std;
import { len, equals, ends_with, substr, clone, to_lower, to_chars, from_chars, free_str, compare, concat } from strings::std;
import { TextBuffer, text_buffer, text_append, text_finish, md_to_html, md_escape_into, filename_url } from markdown::fin;
import { tpl_render } from template::fin;
import { Dir, open_directory, close_directory, name_kind, read_text, write_atomic } from platform::fin;
// fin-ssg: Markdown files in, a static HTML site out.
//
// The generator is deliberately small: no template language of its own, no
// incremental builds, no watcher. It reads `*.md` from one directory, renders
// each through fin-markdown, wraps it in `layout/page.html` through
// fin-template, and writes `<slug>.html` plus a generated `index.html`.
//
// Output is a pure function of the input tree and the flags: files are sorted
// by name before rendering, no timestamp or process id reaches a published
// byte, and each page is written through a temporary name and renamed into
// place. Building the same input twice therefore produces identical files.

const MAX_ARGS <int> = 256;
const MAX_ARG_BYTES <int> = 65536;
const MAX_FILES <int> = 4096;
const MAX_INPUT <int> = 4194304;
const MAX_OUTPUT <int> = 33554432;

struct Argv { args <[string]>, count <int>, ok <bool> }

// The arguments the process was started with, bounded. The compiler's argv
// surface hands them over, so no platform accessor is involved.
fun read_argv(args: [string]) <Argv> {
    let result <Argv> = Argv{args: new [string, MAX_ARGS]{}, count: 0, ok: false};
    let total <int> = args.length;
    if (total > MAX_ARGS) { return result; }
    let bytes <int> = 0;
    for (let i <int> = 0; i < total; i++) {
        let value <string> = args[i];
        if (value == null) { return result; }
        bytes = bytes + len(value);
        if (bytes > MAX_ARG_BYTES) { return result; }
        result.args[result.count] = clone(value);
        result.count++;
    }
    result.ok = true;
    return result;
}

fun free_argv(argv: &Argv) <noret> {
    for (let i <int> = 0; i < argv.count; i++) { free_str(argv.args[i]); }
    delete argv.args;
}

struct FileList { files <[string]>, count <int>, ok <bool> }

// Every `.md` entry in the content directory, sorted by name. The sort is what
// makes the published index and the build order deterministic; the directory's
// own order is not stable between filesystems.
fun list_md_files(dir: Dir) <FileList> {
    let entries <[string]> = walk_dir(dir.path);
    let list <FileList> = FileList{files: new [string, MAX_FILES]{}, count: 0, ok: true};
    for (let i <int> = 0; i < entries.length; i++) {
        let name <string> = entries[i];
        if (name == null) { list.ok = false; continue; }
        if (ends_with(name, ".md") && len(name) > 3) {
            if (list.count == MAX_FILES) { list.ok = false; free_str(name); }
            else { list.files[list.count] = name; list.count++; }
        } else { free_str(name); }
    }
    delete entries;
    for (let i <int> = 1; i < list.count; i++) {
        let name <string> = list.files[i];
        let j <int> = i;
        while (j > 0 && compare(list.files[j - 1], name) > 0) { list.files[j] = list.files[j - 1]; j--; }
        list.files[j] = name;
    }
    return list;
}

fun free_files(list: &FileList) <noret> {
    for (let i <int> = 0; i < list.count; i++) { free_str(list.files[i]); }
    delete list.files;
}

struct PageMeta { title <string>, date <string>, body <string> }

fun blank(c: char) <bool> { return c == ' ' || c == '\t' || c == '\r'; }

// Splits an optional leading `---` block into `title` and `date`. Without a
// block, the title falls back to the file's slug and the body is the file.
fun parse_front_matter(text: string, fallback: string) <PageMeta> {
    let meta <PageMeta> = PageMeta{title: clone(fallback), date: clone(""), body: clone(text)};
    let chars <[char]> = to_chars(text);
    let total <int> = chars.length - 1;
    let first <int> = 0;
    while (first < total && chars[first] != '\n') { first++; }
    let opening <int> = first;
    if (opening > 0 && chars[opening - 1] == '\r') { opening--; }
    if (opening != 3 || chars[0] != '-' || chars[1] != '-' || chars[2] != '-' || first == total) {
        delete chars;
        return meta;
    }
    let close <int> = -1;
    let body <int> = total;
    let i <int> = first + 1;
    while (i < total) {
        let end <int> = i;
        while (end < total && chars[end] != '\n') { end++; }
        let left <int> = i; let right <int> = end;
        while (left < right && blank(chars[left])) { left++; }
        while (right > left && blank(chars[right - 1])) { right--; }
        if (right - left == 3 && chars[left] == '-' && chars[left + 1] == '-' && chars[left + 2] == '-') {
            close = i; body = end;
            if (body < total) { body++; }
            break;
        }
        i = end + 1;
    }
    if (close < 0) { delete chars; return meta; }
    i = first + 1;
    while (i < close) {
        let end <int> = i;
        while (end < close && chars[end] != '\n') { end++; }
        let colon <int> = i;
        while (colon < end && chars[colon] != ':') { colon++; }
        if (colon < end) {
            let left <int> = i; let right <int> = colon;
            while (left < right && blank(chars[left])) { left++; }
            while (right > left && blank(chars[right - 1])) { right--; }
            let key <string> = from_chars(chars, left, right - left);
            left = colon + 1; right = end;
            while (left < right && blank(chars[left])) { left++; }
            while (right > left && blank(chars[right - 1])) { right--; }
            if (equals(key, "title")) { free_str(meta.title); meta.title = from_chars(chars, left, right - left); }
            else if (equals(key, "date")) { free_str(meta.date); meta.date = from_chars(chars, left, right - left); }
            free_str(key);
        }
        i = end + 1;
    }
    free_str(meta.body);
    meta.body = from_chars(chars, body, total - body);
    delete chars;
    return meta;
}

fun free_meta(meta: &PageMeta) <noret> {
    free_str(meta.title);
    free_str(meta.date);
    free_str(meta.body);
}

// Returns owned memory: the caller frees it with `free_str`, and a string
// literal cannot be freed. `clone` is what makes the built-in layout behave
// like a layout read from disk, which is also owned.
fun default_layout() <string> {
    return clone("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{title}} &mdash; {{site_title}}</title>\n<style>body{max-width:42rem;margin:2rem auto;padding:0 1rem;font-family:system-ui,sans-serif;line-height:1.6}pre{background:#f4f4f4;padding:1rem;overflow:auto}code{background:#f4f4f4;padding:.1rem .3rem}pre code{background:none;padding:0}img{max-width:100%}blockquote{border-left:3px solid #ccc;margin-left:0;padding-left:1rem;color:#555}</style>\n</head>\n<body>\n<main>\n{{content}}\n</main>\n</body>\n</html>\n");
}

fun print_usage() <noret> {
    printf("fin-ssg v0.2.0 — static site generator\n");
    printf("usage: fin-ssg [--content DIR] [--layout DIR] [--out DIR] [--title TITLE]\n");
    printf("Aliases: -c, -l, -o, -t; --help/-h. Defaults: content, layout, public, My Site.\n");
    printf("Limits: 256 arguments / 65536 argv bytes, 4096 Markdown files, 4 MiB per input, 32 MiB per page.\n");
    printf("Reads content/*.md (flat), wraps each in layout/page.html, writes <slug>.html + index.html.\n");
    printf("Layouts are trusted HTML; keep the output directory writable only by you.\n");
}

// Reserve the generated homepage and reject ASCII case-folded collisions, so
// the output is the same on a case-insensitive filesystem as on a POSIX one.
fun safe_names(files: &FileList) <bool> {
    let keys <[string]> = new [string, files.count]{};
    let ok <bool> = true;
    for (let i <int> = 0; i < files.count; i++) {
        let key <string> = to_lower(files.files[i]);
        keys[i] = key;
        if (equals(keys[i], "index.md")) { ok = false; }
    }
    for (let i <int> = 1; i < files.count; i++) {
        let key <string> = keys[i];
        let j <int> = i;
        while (j > 0 && compare(keys[j - 1], key) > 0) { keys[j] = keys[j - 1]; j--; }
        keys[j] = key;
    }
    for (let i <int> = 1; i < files.count; i++) {
        if (equals(keys[i - 1], keys[i])) { ok = false; }
    }
    for (let i <int> = 0; i < files.count; i++) { free_str(keys[i]); }
    delete keys;
    return ok;
}

// fin-template has no output bound of its own. Re-impose the published-page
// bound here so a layout repeating {{content}} cannot expand one page past
// MAX_OUTPUT. Returns null on overflow, and the caller leaves any previous
// page in place rather than publishing a truncated one.
fun? render_page(layout: string, site_title: string, title: string, date: string, content: string) <string> {
    let page <string> = tpl_render(layout, site_title, title, date, content);
    if (len(page) > MAX_OUTPUT) { free_str(page); return null; }
    return page;
}

fun load_layout(layout_dir: string) <string> {
    let dir <Dir> = open_directory(layout_dir, false);
    if (!dir.ok) {
        close_directory(&dir);
        return default_layout();
    }
    // A missing layout directory means "use the built-in one". A layout that
    // exists but cannot be read is an error the caller must not paper over.
    if (name_kind(dir, "page.html") == 0) {
        close_directory(&dir);
        return default_layout();
    }
    let value? <string> = read_text(dir, "page.html", MAX_INPUT);
    close_directory(&dir);
    if (value == null) { return clone(""); }
    return value?;
}

fun build_site(content: string, layout_dir: string, out: string, title: string) <int> {
    let input <Dir> = open_directory(content, false);
    if (!input.ok) {
        printf("error: content must be a readable directory: %s\n", content);
        close_directory(&input);
        return 1;
    }
    let files <FileList> = list_md_files(input);
    if (!files.ok || files.count == 0) {
        printf("error: content listing failed, is empty, or exceeds 4096 Markdown files\n");
        free_files(&files);
        close_directory(&input);
        return 1;
    }
    if (!safe_names(&files)) {
        printf("error: index.md is reserved; output names must be unique ignoring ASCII case\n");
        free_files(&files);
        close_directory(&input);
        return 1;
    }
    let layout <string> = load_layout(layout_dir);
    if (len(layout) == 0) {
        printf("error: layout/page.html is unreadable or exceeds 4 MiB\n");
        free_str(layout);
        free_files(&files);
        close_directory(&input);
        return 1;
    }
    let output <Dir> = open_directory(out, true);
    if (!output.ok) {
        printf("error: cannot open/create output directory: %s\n", out);
        free_str(layout);
        free_files(&files);
        close_directory(&input);
        return 1;
    }
    let index <TextBuffer> = text_buffer();
    text_append(&index, "<h1>");
    md_escape_into(&index, title);
    text_append(&index, "</h1>\n<ul>\n");
    let built <int> = 0;
    let failed <int> = 0;
    for (let i <int> = 0; i < files.count; i++) {
        let name <string> = files.files[i];
        let slug <string> = substr(name, 0, len(name) - 3);
        let dest <string> = concat(slug, ".html");
        let raw? <string> = read_text(input, name, MAX_INPUT);
        if (raw == null) {
            printf("warn: unreadable, NUL-containing or >4 MiB input: %s\n", name);
            failed++;
            free_str(dest);
            free_str(slug);
            continue;
        }
        let meta <PageMeta> = parse_front_matter(raw?, slug);
        free_str(raw?);
        let fragment? <string> = md_to_html(meta.body);
        let page? <string> = null;
        if (fragment != null) {
            page = render_page(layout, title, meta.title, meta.date, fragment?);
            free_str(fragment?);
        }
        let ok <bool> = false;
        if (page != null) {
            ok = write_atomic(output, dest, page?);
            free_str(page?);
        }
        if (!ok) {
            printf("warn: rendering limit or publication failure: %s\n", name);
            failed++;
        } else {
            built++;
            text_append(&index, "<li><a href=\"");
            filename_url(&index, dest);
            text_append(&index, "\">");
            md_escape_into(&index, meta.title);
            text_append(&index, "</a>");
            if (len(meta.date) > 0) {
                text_append(&index, " <span class=\"date\">");
                md_escape_into(&index, meta.date);
                text_append(&index, "</span>");
            }
            text_append(&index, "</li>\n");
            printf("built %s -> %s\n", name, dest);
        }
        free_meta(&meta);
        free_str(dest);
        free_str(slug);
    }
    text_append(&index, "</ul>\n");
    let body? <string> = text_finish(&index);
    let index_ok <bool> = false;
    if (body != null) {
        let page? <string> = render_page(layout, title, title, "", body?);
        free_str(body?);
        if (page != null) {
            index_ok = write_atomic(output, "index.html", page?);
            free_str(page?);
        }
    }
    close_directory(&output);
    close_directory(&input);
    free_str(layout);
    free_files(&files);
    if (!index_ok) {
        printf("error: index rendering limit or publication failure\n");
        return 1;
    }
    printf("fin-ssg: %d page(s) + index -> %s/ (%d skipped)\n", built, out, failed);
    if (failed > 0) { return 2; }
    return 0;
}

fun main(args: [string]) <int> {
    let ap <ArgParser> = new_arg_parser("fin-ssg", "Static site generator");
    ap.add_option("--content", "-c", "content", "content directory");
    ap.add_option("--layout", "-l", "layout", "layout directory");
    ap.add_option("--out", "-o", "public", "output directory");
    ap.add_option("--title", "-t", "My Site", "site title");
    ap.add_flag("--help", "-h", "show help");
    let argv <Argv> = read_argv(args);
    let result <int> = 1;
    if (!argv.ok) {
        printf("error: cannot read complete argv (max 256 args / 65536 bytes)\n");
    } else if (!ap.parse(argv.args, argv.count)) {
        printf("error: %s\n", ap.error_msg);
    } else if (ap.get_positional_count() != 0) {
        printf("error: unexpected positional argument\n");
    } else if (ap.get_flag("--help")) {
        print_usage();
        result = 0;
    } else {
        result = build_site(ap.get_option("--content"), ap.get_option("--layout"), ap.get_option("--out"), ap.get_option("--title"));
    }
    free_argv(&argv);
    free_arg_parser(ap);
    return result;
}
